FIREWORKS_API_KEY=
LLM_PROVIDER=fireworks
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b
# Optional for the default model: built-in Standard rates are $0.15 input/$0.60 output.
# Custom models require both verified prices.
